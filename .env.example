# App
APP_NAME=Math Homework Helper
SECRET_KEY=change-me-to-a-long-random-string

# Google Gemini powers the solver and tutor. Keys live at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Leave empty to use a local SQLite file in the instance folder.
DATABASE_URL=

# Optional Google sign in. The button appears once both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail sends the password reset emails to everyone. Use a Gmail app password, not your normal password.
SMTP_USER=
SMTP_PASSWORD=

# Resend is the backup sender, used only when the Gmail lines above are empty. Keys live at https://resend.com/api-keys
RESEND_API_KEY=
# Leave empty to send from onboarding@resend.dev, or use an address on a domain you verified in Resend.
MAIL_FROM=

# Contact address shown on the privacy and terms pages.
SUPPORT_EMAIL=

# The one admin account, created when the app starts. Use a password of at least 8 characters.
# Changing ADMIN_PASSWORD later resets the admin password the next time the app starts.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Kept from the old app for later use.
SUPABASE_URL=
SUPABASE_ANON_KEY=
